{
  "indentWidth": 2,
  "useTabs": false,
  "lineWidth": 9999,
  "newLineKind": "lf",
  "typescript": {
    "useBraces": "always",
    "preferHanging": false,
    "preferSingleLine": false,
    "singleBodyPosition": "nextLine",
    "exportDeclaration.forceMultiLine": "never",
    "exportDeclaration.forceSingleLine": true,
    "importDeclaration.forceMultiLine": "never",
    "importDeclaration.forceSingleLine": true,
    "arrowFunction.useParentheses": "force",
    "arrowFunction.bracePosition": "sameLine",
  },
  "json": {
    "array.preferSingleLine": false,
    "object.preferSingleLine": false,
    "trailingCommas": "never",
    "overrides": {
      "files": "**/*.jsonc",
      "trailingCommas": "always",
    },
  },
  "markdown": {
    "textWrap": "never",
    "list.indentKind": "commonMark",
    "list.unorderedMarker": "dashes",
  },
  "sh": {
    "switchCaseIndent": true,
  },
  "toml": {},
  "dockerfile": {},
  "mago": {},
  "ruff": {},
  "jupyter": {},
  "gofumpt": {},
  "malva": {},
  "markup": {},
  "yaml": {},
  "graphql": {},
  "typstyle": {},
  "sql": {},
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --config edition=2024",
        "exts": [
          "rs",
        ],
      },
      {
        "command": "just --fmt --justfile -",
        "fileNames": [
          "justfile"
        ],
        "exts": [
          "just",
        ],
      },
    ],
  },
  "cmakefmt": {},
  "arity": {},
  "fatou": {},
  "badness": {},
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
  ],
  "plugins": [
    "https://plugins.dprint.dev/apcamargo/typstyle-0.1.0.wasm",
    "https://plugins.dprint.dev/jolars/arity-v1.1.3.wasm",
    "https://plugins.dprint.dev/jolars/badness-v1.2.2.wasm",
    "https://plugins.dprint.dev/jolars/fatou-v0.7.5.wasm",
    "https://plugins.dprint.dev/sargunv/dprint-cmakefmt-0.1.0.wasm",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/jupyter@0.5.0",
    "npm:@dprint/mago@0.35.0",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/ruff@0.11.1",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.19",
    "npm:@kachick/dprint-plugin-sh@0.1.2",
    "npm:dprint-plugin-graphql@0.2.3",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:lax-sql@0.3.0",
  ],
}
