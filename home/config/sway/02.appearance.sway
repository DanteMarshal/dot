### Appearance
  default_border pixel 2
  #                       title border  title bg  title text  indicator  window border
  client.focused          #000080       #000080   #ffffff     #808000    #800000
  client.unfocused        #000000       #000000   #ffffff     #808000    #000000
  client.focused_inactive #000020       #000020   #ffffff     #202000    #200000
### Status Bar
  # Read `man 5 sway-bar` for more information about this section.
  bar {
    position bottom
    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    status_command while date +'%Y-%m-%d %H:%m:%S'; do sleep 15; done
    colors {
      background #323232
      statusline #ffffff
      #                  border      background   text
      focused_workspace  #800000FF #004080FF    #ffffff
      inactive_workspace #00000000 #00204000    #808080
      inactive_workspace #32323200 #32323200    #5c5c5c
    }
  }
