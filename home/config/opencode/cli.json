{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "debug": {
    "devtools": true
  },
  "diffs": {
    "fullscreen": true,
    "single": true,
    "tree": true,
    "view": "auto",
    "wrap": "word"
  },
  "highlights": true,
  "keybinds": {
    "leader": "ctrl+t",
    "variant.cycle": "ctrl+r",
    "session.rename": "ctrl+s",
    "session.tab.close": "ctrl+w",
    "session.quick_switch.1": "alt+1",
    "session.quick_switch.2": "alt+2",
    "session.quick_switch.3": "alt+3",
    "session.quick_switch.4": "alt+4",
    "session.quick_switch.5": "alt+5",
    "session.quick_switch.6": "alt+6",
    "session.quick_switch.7": "alt+7",
    "session.quick_switch.8": "alt+8",
    "session.quick_switch.9": "alt+9"
  },
  "leader": {
    "timeout": 2000
  },
  "plugins": [],
  "prompt": {
    "editor": true,
    "image_preview": true,
    "paste": "full"
  },
  "scroll": {
    "acceleration": true,
    "speed": 5
  },
  "session": {
    "grouping": "auto",
    "image_preview": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "autoaccept",
    "scrollbar": true,
    "sidebar": "hide",
    "submit_scroll": "bottom",
    "thinking": "show",
    "tps": true,
    "verbosity": "high"
  },
  "tabs": {
    "indicators": "numbers",
    "layout": "horizontal",
    "mode": "on",
    "scope": "cwd"
  },
  "terminal": {
    "copy": "select",
    "title": true
  },
  "theme": {
    "mode": "system",
    "name": "mercury"
  }
}
